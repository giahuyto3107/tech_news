# ==============================================================================
# Build & Gradle
# ==============================================================================
.gradle/
**/build/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle/wrapper/gradle-wrapper.jar

# Cache of project
.gradletasknamecache

# Kotlin Gradle plugin data
.kotlin/

# Kotlin Native / Multiplatform
.konan/
kotlin-js-store/

