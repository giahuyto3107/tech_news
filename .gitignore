# ==============================================================================
.idea/
*.iml
*.ipr
*.iws

# Local configuration file (sdk path, etc.)
**/local.properties

# Navigation editor temp files
.navigation/

# Android Studio captures & profiling
**/captures/
*.hprof

# External native build folder generated in Android Studio
.externalNativeBuild/
.cxx/

